APP_NAME="MultiShop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the URL you serve the backend on (image URLs and payment callbacks use it).
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database (MySQL 8+ / MariaDB 10.6+) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multishop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Uploaded images are stored on the public disk (run: php artisan storage:link)
FILESYSTEM_DISK=public
MEDIA_DISK=public
# Image conversions (thumb / medium / webp) and notifications run on the queue.
# Use "sync" if you don't want to run a queue worker.
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@multishop.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---- React SPA ----
# Used for CORS and for redirecting customers back after online payment.
FRONTEND_URL=http://localhost:5173
# Optional: comma-separated list of extra allowed origins (defaults to FRONTEND_URL)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- JWT (php-open-source-saver/jwt-auth) ----
# Generate with: php artisan jwt:secret
JWT_SECRET=
JWT_ALGO=HS256
# Access token lifetime (minutes) and refresh window (minutes, 14 days)
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

# ---- SSLCommerz (optional) ----
# Free sandbox credentials: https://developer.sslcommerz.com/registration/
# Leave empty to offer Cash on Delivery only.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
